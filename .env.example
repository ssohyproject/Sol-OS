# ==============================================================================
# SolOS Environment Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server & App Settings
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME="SolOS ERP"
APP_URL=http://localhost:3000

# Gemini API key (server only)
GEMINI_API_KEY=
PORT=3000

# Firebase Console > Project settings > Your apps > Web app configuration
# Firebase 콘솔 (https://console.firebase.google.com/) > 프로젝트 설정 > 내 앱(웹 </>)에서 확인한 값을 입력하세요.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Google OAuth 2.0 Web Client ID (Calendar & Drive API)
GOOGLE_CLIENT_ID=

# Optional email prefill in login/signup forms. This does not grant access.
DEFAULT_LOGIN_EMAIL=

# Cloud Run deployment. Log in to this account with gcloud auth login first.
GOOGLE_CLOUD_ACCOUNT=
GOOGLE_CLOUD_PROJECT_ID=
CLOUD_RUN_SERVICE_NAME=
CLOUD_RUN_REGION=
ARTIFACT_REGISTRY_REPOSITORY=

# Public URL loaded by Android and Web Clients.
WEB_APP_URL=https://creek-david-img-dozen.trycloudflare.com
SOLOOS_API_URL=http://localhost:3000

