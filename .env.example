# ==============================================================================
# SoloOS Environment Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server & App Settings
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
APP_NAME="SoloOS ERP"
APP_URL=http://localhost:8080

# Firebase Configuration (Cloud Run, Firestore, Auth)
FIREBASE_PROJECT_ID=soloos-erp
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=soloos-erp.firebaseapp.com
FIREBASE_STORAGE_BUCKET=soloos-erp.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_APP_ID=your_firebase_app_id_here

# AI & LLM Service (Gemini API for Conversational AI CFO mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Security & Sessions (Optional)
SESSION_SECRET=your-secret-session-key-here
JWT_SECRET=your-jwt-secret-key-here
