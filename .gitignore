# ==============================================================================
# SoloOS .gitignore
# Node.js, Web, Python, Cloud Run, Firebase, OS & IDE Configurations
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.envrc
!.env.example

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# Node.js & Frontend Dependencies
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Build & Bundler Outputs
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist
.temp
.cache/
.parcel-cache/
.turbo/

